{
  "name": "sccache-action",
  "version": "1.0.0",
  "description": "Forgejo Action for Sccache",
  "main": "dist/setup/index.js",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build-dist": "tsc && ncc build lib/setup.js -m -o dist/setup/ && ncc build lib/show_stats.js -m -o dist/show_stats",
    "build": "prettier --write **/*.ts && npm run build-dist",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint **/*.ts --cache",
    "test": "jest --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git.cisnt.uk/actions/sccache-action.git"
  },
  "keywords": [
    "sccache"
  ],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://git.cisnt.uk/actions/sccache-action/issues"
  },
  "homepage": "https://git.cisnt.uk/actions/sccache-action#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/ncc": "^0.45.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.0.0",
    "eslint-plugin-prettier": "^5.2.5",
    "jest": "^30.0.0",
    "jest-circus": "^30.0.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "typescript": "^6.0.0"
  }
}
